# Groibe production environment, for a shared cPanel host. Copy to `.env` on the server and fill in the values marked CHANGE.
# Never commit the real `.env`. Nothing in this file is a secret: every secret is left empty.
# docs/DEPLOY.md says where each value comes from and in what order to do things.

APP_NAME=Groibe
APP_ENV=production                    # `staging` on the staging site; `local` is refused by scripts/deploy.sh
APP_KEY=                               # CHANGE: run `php artisan key:generate --force` once, on the server. Never copy a development key.
APP_DEBUG=false                        # Must stay false. Debug pages show secrets.
APP_URL=https://CHANGE.example.com     # CHANGE: the public address, with https and no trailing slash.
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs: one file a day, 14 days kept (spec 17.4).
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
# `info`, not `warning`: the daily database size check is logged at info level (SCR-034).
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Database. Use `mysql` even when the host runs MariaDB: the search indexes are only created for that name (SUGGESTIONS 299).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=                           # CHANGE: cPanel prefixes it, for example cpuser_groibe
DB_USERNAME=                           # CHANGE: cPanel prefixes it too
DB_PASSWORD=                           # CHANGE: set in cPanel, MySQL Databases
DB_SIZE_LIMIT_MB=1024                  # CHANGE: a little under the hosting plan's real database limit. Super admins are warned at 80%.

# Shared hosting: no Redis, no persistent processes (spec 17.1). The cron entry drains the queue.
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=file
CACHE_PREFIX=groibe
FILESYSTEM_DISK=local
# Anything stored without a named disk stays private (the app names `local` for every file collection already).
MEDIA_DISK=local
BROADCAST_CONNECTION=log

# Mail. Use the SMTP mailbox made in cPanel for the sending domain (Email Accounts). See DEPLOY.md for SPF, DKIM and DMARC.
MAIL_MAILER=smtp
MAIL_SCHEME=null                       # Port 465 needs `smtps`. Port 587 uses `null` and starts TLS by itself.
MAIL_HOST=                             # CHANGE: the host's mail server name, from the cPanel email settings
MAIL_PORT=587
MAIL_USERNAME=                         # CHANGE: the full mailbox address
MAIL_PASSWORD=                         # CHANGE: the mailbox password
MAIL_FROM_ADDRESS=                     # CHANGE: an address on the sending domain, for example no-reply@yourdomain
MAIL_FROM_NAME="Groibe"

# Groibe
ADMIN_NAME="Groibe Admin"
ADMIN_EMAIL=                           # CHANGE: the first super admin's email
ADMIN_PASSWORD=                        # CHANGE for the first seed only, then DELETE this line and the value from the file.
GROIBE_CONTACT_EMAIL=                  # CHANGE: where contact form messages are emailed
GROIBE_EXCEPTION_EMAIL=                # CHANGE: where unhandled errors are emailed, once an hour each
# Behind Cloudflare, Cloudflare's own address ranges, comma separated (https://www.cloudflare.com/ips-v4 and /ips-v6), so a request that
# reaches the server directly cannot fake its address and dodge the rate limits. `*` trusts any sender: use it only if the server
# accepts web traffic from Cloudflare alone. With no proxy at all, leave it empty. DEPLOY.md, "Cloudflare".
TRUSTED_PROXIES=
HSTS_MAX_AGE=31536000
# For the first deploy only: `true` reports what the Content-Security-Policy would block, in the browser console, without blocking.
CSP_REPORT_ONLY=false

# Weekly database dumps (`groibe:backup-db`). The folder must be OUTSIDE the web root, for example the folder above the app.
GROIBE_BACKUP_PATH=                    # CHANGE: for example /home/CPANELUSER/groibe-backups
GROIBE_BACKUP_KEEP=4
# The dump taken before every deploy (`groibe-predeploy-*`), kept apart from the weekly ones.
GROIBE_PREDEPLOY_BACKUP_KEEP=5

VITE_APP_NAME="${APP_NAME}"
